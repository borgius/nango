#
# Cloudflare deployment bootstrap configuration
#
# Copy this file to .env.cloudflare and fill in the values below.
#

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_NAME=nango
CLOUDFLARE_D1_DATABASE=nango-control
CLOUDFLARE_KV_NAMESPACE=nango-cache
CLOUDFLARE_R2_BUCKET=nango-artifacts
CLOUDFLARE_QUEUE=nango-jobs
